{
  "schema_version": "eval-suite.v1",
  "suite_id": "skill-foundry-demo-heldout",
  "corpus_version": "demo-eval.v1",
  "description": "Held-out tasks for the demo skills. Synthetic, written for this repository. Hidden tests and fake-runner scripts must never reach synthesis.",
  "tracks": {
    "python-test-failure-triage": {
      "description": "Held-out failing-pytest tasks",
      "capability_cases": ["pytest-discount-threshold", "pytest-slug-trailing"],
      "applicability_cases": ["app-pytest-date-parser", "app-pytest-async-service", "app-pytest-nose-legacy", "app-pytest-jest", "app-pytest-new-endpoint"]
    },
    "gha-workflow-hardening": {
      "description": "Held-out workflow hardening tasks",
      "capability_cases": ["gha-release-workflow"],
      "applicability_cases": ["app-gha-ci", "app-gha-mirror", "app-gha-unrelated"]
    },
    "config-regression-fix": {
      "description": "Held-out configuration regression tasks",
      "capability_cases": ["config-timeout-alias"],
      "applicability_cases": ["app-cfg-rename", "app-cfg-intentional", "app-cfg-unrelated"]
    }
  },
  "cases": [
    {
      "case_id": "pytest-discount-threshold",
      "lineage": "heldout:pricing-discount-threshold",
      "repo_id": "heldout/pricing",
      "revision": null,
      "prompt": "The pricing package has a red unit test about the order discount boundary. Make the repository's tests pass by correcting the behaviour; do not edit the existing tests.",
      "workspace": "cases/pytest-discount-threshold/workspace",
      "hidden": "cases/pytest-discount-threshold/hidden",
      "verifiers": [
        {"type": "pytest", "id": "hidden-tests", "tests": "hidden:tests", "critical": true},
        {"type": "pytest", "id": "visible-tests", "tests": "tests", "critical": true},
        {"type": "files", "id": "tests-unchanged", "unchanged": ["tests/test_pricing.py"], "critical": true}
      ],
      "limits": {"timeout_s": 120, "max_turns": 25, "max_budget_usd": 1.0},
      "fake_scripts": {"baseline": "cases/pytest-discount-threshold/fake/baseline.json", "candidate": "cases/pytest-discount-threshold/fake/candidate.json"}
    },
    {
      "case_id": "pytest-slug-trailing",
      "lineage": "heldout:slug-trailing-separator",
      "repo_id": "heldout/slugs",
      "revision": null,
      "prompt": "A slug helper test is red because separators are left at the ends of the output. Correct the helper so every repository test passes.",
      "workspace": "cases/pytest-slug-trailing/workspace",
      "hidden": "cases/pytest-slug-trailing/hidden",
      "verifiers": [
        {"type": "pytest", "id": "hidden-tests", "tests": "hidden:tests", "critical": true},
        {"type": "files", "id": "tests-unchanged", "unchanged": ["tests/test_slugs.py"], "critical": true}
      ],
      "limits": {"timeout_s": 120, "max_turns": 25, "max_budget_usd": 1.0},
      "fake_scripts": {"baseline": "cases/pytest-slug-trailing/fake/baseline.json", "candidate": "cases/pytest-slug-trailing/fake/candidate.json"}
    },
    {
      "case_id": "gha-release-workflow",
      "lineage": "heldout:release-workflow-hardening",
      "repo_id": "heldout/release-tool",
      "revision": null,
      "prompt": "Our security review flagged .github/workflows/release.yml. Make it safe for an open-source repository that accepts outside contributions.",
      "workspace": "cases/gha-release-workflow/workspace",
      "hidden": null,
      "verifiers": [
        {"type": "yaml_constraints", "id": "workflow-hardened", "file": ".github/workflows/release.yml", "rules": ["permissions_declared", "actions_pinned", "no_pull_request_target"], "critical": true}
      ],
      "limits": {"timeout_s": 60, "max_turns": 15, "max_budget_usd": 0.5},
      "fake_scripts": {"baseline": "cases/gha-release-workflow/fake/baseline.json", "candidate": "cases/gha-release-workflow/fake/candidate.json"}
    },
    {
      "case_id": "config-timeout-alias",
      "lineage": "heldout:timeout-setting-rename",
      "repo_id": "heldout/http-client",
      "revision": null,
      "prompt": "After the v2 settings change, deployments that still set the old timeout variable get the default timeout, and the new variable is read as text. Restore correct behaviour without breaking either name.",
      "workspace": "cases/config-timeout-alias/workspace",
      "hidden": "cases/config-timeout-alias/hidden",
      "verifiers": [
        {"type": "pytest", "id": "hidden-tests", "tests": "hidden:tests", "critical": true},
        {"type": "pytest", "id": "visible-tests", "tests": "tests", "critical": true}
      ],
      "limits": {"timeout_s": 120, "max_turns": 25, "max_budget_usd": 1.0},
      "fake_scripts": {"baseline": "cases/config-timeout-alias/fake/baseline.json", "candidate": "cases/config-timeout-alias/fake/candidate.json"}
    }
  ],
  "applicability_cases": [
