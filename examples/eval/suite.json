    {"case_id": "app-cfg-intentional", "task": "Fix configuration regression where the config change was an intentional breaking change already announced", "environment": {"runtime": "python 3.12.4", "platform": "ubuntu-24.04", "versions": {"python": "3.12.4", "pydantic-settings": "2.4.0"}}, "signals": ["ConfigValidationError"], "expected": "do_not_use", "reason": "reported contraindication"},
